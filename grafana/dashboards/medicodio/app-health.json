{
  "uid": "medicodio-app-health",
  "title": "App Health",
  "tags": ["medicodio"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 6,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "env",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(app_http_request_duration_seconds_count, env)", "refId": "env" },
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate (req/s)",
      "description": "How many HTTP requests the backend is serving per second, averaged over the last 5 minutes. Rising line = more traffic.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (env) (rate(app_http_request_duration_seconds_count{env=~\"$env\"}[5m]))",
          "legendFormat": "{{env}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 2,
      "title": "p95 latency (s)",
      "description": "95th-percentile response time. 95 out of every 100 requests finished faster than this. Good tail-latency signal — a rising p95 hurts real users before averages notice.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (env, le) (rate(app_http_request_duration_seconds_bucket{env=~\"$env\"}[5m])))",
          "legendFormat": "{{env}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 3,
      "title": "HTTP status breakdown (req/s)",
      "description": "Requests per second, coloured by HTTP status class. 2xx = success, 3xx = redirect, 4xx = client error (bad input / auth fail), 5xx = server error (real bug). Big 4xx = someone hammering; big 5xx = app broken.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 7, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_class) (rate(app_http_request_duration_seconds_count{env=~\"$env\"}[5m]))",
          "legendFormat": "{{status_class}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "stacking": { "mode": "normal" } } } }
    },
    {
      "id": 4,
      "title": "Memory — RSS + heap used (MB)",
      "description": "Backend process memory. RSS = total physical RAM the Node.js process is holding (code + heap + buffers + native modules). Heap = JavaScript objects only. Slow, steady RSS climb = memory leak.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 7, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "app_process_resident_memory_bytes{env=~\"$env\"} / 1024 / 1024",
          "legendFormat": "{{env}} RSS"
        },
        {
          "refId": "B",
          "expr": "app_nodejs_heap_size_used_bytes{env=~\"$env\"} / 1024 / 1024",
          "legendFormat": "{{env}} heap"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "decmbytes" } }
    },
    {
      "id": 10,
      "title": "Process CPU (cores)",
      "description": "Fractional CPU cores the backend process is using. 1.0 = one full core; 2.0 = two full cores. This is the Node.js process only, not the whole VM.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(app_process_cpu_seconds_total{env=~\"$env\"}[5m])",
          "legendFormat": "{{env}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "min": 0 } }
    },
    {
      "id": 5,
      "title": "Event-loop lag (s)",
      "description": "How long a scheduled task waited before Node.js could run it, at p95. Node is single-threaded — sustained lag > 100 ms means the app is CPU-blocked (heavy sync code, big JSON parses) and requests are queuing up.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "app_nodejs_eventloop_lag_p95_seconds{env=~\"$env\"}",
          "legendFormat": "{{env}} p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 6,
      "title": "Job last success (min ago)",
      "description": "For each background cron job, minutes since it last completed successfully. Large / growing = job is stuck or crashing. Empty on dev/uat because JOBS_ENABLED=false there.",
      "type": "table",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "(time() - app_job_last_success_timestamp_seconds{env=~\"$env\"}) / 60",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 7,
      "title": "Job runs — last 1h",
      "description": "How many times each background job ran in the last hour, split by outcome (success / failure). Failures column non-zero = investigate. Empty on dev/uat because jobs are off there.",
      "type": "table",
      "gridPos": { "x": 0, "y": 26, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, outcome) (increase(app_job_runs_total{env=~\"$env\"}[1h]))",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 8,
      "title": "Errors + warnings",
      "description": "Live tail of log lines where level=error or level=warn. First place to look when something breaks.",
      "type": "logs",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{env=~\"$env\",service=\"medicodio-app\"} | json | level=~\"error|warn\""
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true }
    },
    {
      "id": 11,
      "title": "Top 5 routes by 5xx rate",
      "description": "Which routes are throwing server errors (HTTP 5xx) right now. Empty = zero 5xx across the app. First place to look when the error rate panel goes red — turns 'the app is broken' into 'route X is broken.'",
      "type": "table",
      "gridPos": { "x": 12, "y": 26, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(5, sum by (route) (rate(app_http_request_duration_seconds_count{env=~\"$env\",status_class=\"5xx\"}[5m])))",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 12,
      "title": "Availability (per env)",
      "description": "Whether Prometheus successfully scraped the backend on its last try. 1 = up, 0 = down. Populates as each env is wired in — dev today, uat + prod later. First panel to check when nothing else has data.",
      "type": "stat",
      "gridPos": { "x": 0, "y": 32, "w": 24, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"app-.*\"}",
          "legendFormat": "{{job}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" }
    },
    {
      "id": 9,
      "title": "Logs",
      "description": "Every log line the backend emitted, newest first. Filter with the env dropdown at the top. Use Logs Explorer dashboard for advanced filtering.",
      "type": "logs",
      "gridPos": { "x": 0, "y": 36, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{env=~\"$env\",service=\"medicodio-app\"}"
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true }
    }
  ]
}
